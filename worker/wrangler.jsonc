{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hufschlag-leaderboard",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://eric2122.github.io,http://127.0.0.1:4173,http://localhost:4173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hufschlag-leaderboard",
      "database_id": "da554b10-776e-473a-82b9-0e16d9f76cf2",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
