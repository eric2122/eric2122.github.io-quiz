{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hufschlag-leaderboard",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-19",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://eric2122.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "da554b10-776e-473a-82b9-0e16d9f76cf2"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
